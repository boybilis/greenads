Options -MultiViews

RewriteEngine On

# Keep real files, folders, ajax endpoints, and page includes untouched.
RewriteRule ^(?:ajax|pages)/ - [L,NC]

# Redirect direct .php page visits to clean URLs.
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]|$) [NC]
RewriteRule ^ /%1 [R=302,L,NE]

# Serve clean URLs from matching PHP files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
